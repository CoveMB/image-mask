root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{html,css,js,json,toml,yml,yaml}]
indent_size = 2

[*.md]
# Preserve intentional Markdown hard line breaks.
trim_trailing_whitespace = false

# Historical source snapshots are not formatting targets.
[Photo-workflow-reference/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
indent_style = unset
indent_size = unset
trim_trailing_whitespace = unset

[single-photo-black-background-implementation-plan-v4-2026-10-11.txt]
charset = unset
end_of_line = unset
insert_final_newline = unset
indent_style = unset
indent_size = unset
trim_trailing_whitespace = unset
